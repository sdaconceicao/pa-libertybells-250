OPENCAGE_API_KEY=your_key_here
PLAYWRIGHT_BASE_URL=http://localhost:3000

# --- Authentication (Better Auth) ---
# Secret used to sign sessions/cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_WITH_YOUR_SECRET
# Base URL of the app. Local dev: http://localhost:3000  |  Prod: https://your-domain.com
BETTER_AUTH_URL=http://localhost:3000

# --- Database (Neon Postgres) ---
# Neon connection string (use the pooled connection string for serverless).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Google OAuth ---
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_YOUR_SECRET

# --- Facebook OAuth ---
# https://developers.facebook.com/apps  (Facebook Login product)
# Valid OAuth redirect URI: <BETTER_AUTH_URL>/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=REPLACE_WITH_YOUR_ID
FACEBOOK_CLIENT_SECRET=REPLACE_WITH_YOUR_SECRET
